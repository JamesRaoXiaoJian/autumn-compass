# Variable reference only: the root scripts do not auto-load this file.
# Export values in your shell/PowerShell or inject them through a service manager.
# Web and API remain loopback-only. Forward the Web port for remote access.
AUTUMN_COMPASS_HOST=127.0.0.1
AUTUMN_COMPASS_PORT=5173
AUTUMN_COMPASS_API_HOST=127.0.0.1
AUTUMN_COMPASS_API_PORT=4174

# Optional. Company trademark artwork is excluded from public source. Set this
# only when locally supplied assets under apps/web/public/company-logos/ may be used.
# VITE_ENABLE_LOCAL_COMPANY_LOGOS=true

# Optional. When omitted, the server uses the OS-specific user data directory.
# AUTUMN_COMPASS_DB_PATH=/absolute/path/to/workspace.sqlite

# Optional private encrypted sync. Supply real values only in an ignored local
# file or the process environment; never commit them.
# FALL_RECRUITMENT_SYNC_REMOTE=user@ssh-host.example
# FALL_RECRUITMENT_SYNC_SSH_PORT=22
# FALL_RECRUITMENT_SYNC_HOST_FINGERPRINT=SHA256:<verified-ed25519-fingerprint>
# FALL_RECRUITMENT_SYNC_SSH_IDENTITY=/absolute/path/to/private-key
